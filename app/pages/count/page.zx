var count: u32 = 0;
pub fn Page(ctx: zx.PageContext) !zx.Component {
    count = ctx.request.cookies.as("count", u32) orelse 0;
    count += 1;
    const count_str = try ctx.fmt("{d}", .{count});
    ctx.response.cookies.set("count", count_str, .{});

    return (
        <div>
            <h1>Count: {count}</h1>
        </div>
    );
}

const zx = @import("zx");
